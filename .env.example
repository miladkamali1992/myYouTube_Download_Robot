# کپی این فایل به .env کنید و مقادیر واقعی را جایگزین کنید.
# فایل .env هرگز به گیت اضافه نمی‌شود (در .gitignore قرار دارد).

# --- تلگرام (از my.telegram.org و @BotFather) ---
TELEGRAM_API_ID=123456
TELETHON_API_HASH=0123456789abcdef0123456789abcdef
BOT_TOKEN=123456789:AA...your_bot_token_here
BOT_USERNAME=YourBotUsername

# --- ادمین‌ها (یوزر آی‌دی عددی تلگرام، با کاما جدا شود) ---
ADMIN_USER_IDS=123456789

# --- حالت تست: 1 = فقط ادمین‌ها سرویس می‌گیرند، 0 = عمومی ---
TEST_MODE=1

# --- دیتابیس PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@127.0.0.1:5432/myYouTube_Download_Robot

# --- پروکسی اختیاری (خالی = بدون پروکسی) ---
PROXY_URL=
